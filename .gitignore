# This .gitignore file should be placed at the root of your Unity project directory

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the asset is ignored
!/[Aa]ssets/**/*.meta

# Uncomment if you use Addressables and don't want generated files
# /[Ss]erverData/

# Visual Studio cache
.vs/

# Rider
.idea/
*.sln.iml

# Visual Studio generated files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated files
sysinfo.txt

# Crash reports
*.stacktrace

# Builds
*.apk
*.aab
*.unitypackage

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text