{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "572feb53ad174afc9955ed19eb978140",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Kuwahara (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -965.0,
            "y": 208.0,
            "width": 210.0,
            "height": 125.00003051757813
        }
    },
    "m_Slots": [
        {
            "m_Id": "bf6b9a48b25247a897c492d81bec9efd"
        },
        {
            "m_Id": "3946232ecdac450d99cd9bd86b71fd7e"
        },
        {
            "m_Id": "58ce329bd09e4cde932097f53c6ad809"
        },
        {
            "m_Id": "7bf9b6d08fd54ccf9d536c6b2c3473a4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "Kuwahara",
    "m_FunctionSource": "0eff362ba929050408ef36c51af09bdc",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "TEXTURE2D_X(_BlitTexture);\r\nSAMPLER(sampler_LinearClamp);\r\n\r\nvoid Kuwahara_float(\r\n    float2 UV,\r\n    float Radius,\r\n    out float3 Color)\r\n{\r\n    float3 mean[4];\r\n    float3 sigma[4];\r\n\r\n    [unroll]\r\n    for(int k = 0; k < 4; k++)\r\n    {\r\n        mean[k] = 0;\r\n        sigma[k] = 0;\r\n    }\r\n\r\n    int r = (int)Radius;\r\n\r\n    // Haut gauche\r\n    for(int y = -r; y <= 0; y++)\r\n    {\r\n        for(int x = -r; x <= 0; x++)\r\n        {\r\n            float2 uv = UV + float2(x,y) * _ScreenParams.zw;\r\n            float3 c = SAMPLE_TEXTURE2D_X(\r\n                _BlitTexture,\r\n                sampler_LinearClamp,\r\n                uv\r\n            ).rgb;\r\n\r\n            mean[0] += c;\r\n            sigma[0] += c * c;\r\n        }\r\n    }\r\n\r\n    // Haut droit\r\n    for(int y = -r; y <= 0; y++)\r\n    {\r\n        for(int x = 0; x <= r; x++)\r\n        {\r\n            float2 uv = UV + float2(x,y) * _ScreenParams.zw;\r\n            float3 c = SAMPLE_TEXTURE2D_X(\r\n                _BlitTexture,\r\n                sampler_LinearClamp,\r\n                uv\r\n            ).rgb;\r\n\r\n            mean[1] += c;\r\n            sigma[1] += c * c;\r\n        }\r\n    }\r\n\r\n    // Bas gauche\r\n    for(int y = 0; y <= r; y++)\r\n    {\r\n        for(int x = -r; x <= 0; x++)\r\n        {\r\n            float2 uv = UV + float2(x,y) * _ScreenParams.zw;\r\n            float3 c = SAMPLE_TEXTURE2D_X(\r\n                _BlitTexture,\r\n                sampler_LinearClamp,\r\n                uv\r\n            ).rgb;\r\n\r\n            mean[2] += c;\r\n            sigma[2] += c * c;\r\n        }\r\n    }\r\n\r\n    // Bas droit\r\n    for(int y = 0; y <= r; y++)\r\n    {\r\n        for(int x = 0; x <= r; x++)\r\n        {\r\n            float2 uv = UV + float2(x,y) * _ScreenParams.zw;\r\n            float3 c = SAMPLE_TEXTURE2D_X(\r\n                _BlitTexture,\r\n                sampler_LinearClamp,\r\n                uv\r\n            ).rgb;\r\n\r\n            mean[3] += c;\r\n            sigma[3] += c * c;\r\n        }\r\n    }\r\n\r\n    float n = (r + 1) * (r + 1);\r\n\r\n    float minVariance = 1e20;\r\n    float3 result = 0;\r\n\r\n    [unroll]\r\n    for(int k = 0; k < 4; k++)\r\n    {\r\n        mean[k] /= n;\r\n        sigma[k] = abs(sigma[k] / n - mean[k] * mean[k]);\r\n\r\n        float variance =\r\n            sigma[k].r +\r\n            sigma[k].g +\r\n            sigma[k].b;\r\n\r\n        if(variance < minVariance)\r\n        {\r\n            minVariance = variance;\r\n            result = mean[k];\r\n        }\r\n    }\r\n\r\n    Color = result;\r\n}"
}

