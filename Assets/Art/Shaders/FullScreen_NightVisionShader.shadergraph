    },
    "m_SourceType": 1,
    "m_FunctionName": "NVGGrain",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Multiplie la résolution pour un grain très fin\r\nfloat2 st = UV * 1000.0; \r\nOut = frac(sin(dot(st + Time, float2(12.9898, 78.233))) * 43758.5453);"
}

