{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "80c902337977474ba2c9ede6a6107c89",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "NightVisionPro (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1760.0,
            "y": 1768.0,
            "width": 238.0,
            "height": 245.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "2ba8e84cf3ea461cbdfb41445df45fa1"
        },
        {
            "m_Id": "4cc2dcc1e3394feb8a7cff42d2613d32"
        },
        {
            "m_Id": "47c61106fa4846a88cb620315187586e"
        },
        {
            "m_Id": "ad146e8594c34c5caf3a68fdba89aed3"
        },
        {
            "m_Id": "d4d2f1660cea46efbe139835a6897166"
        },
        {
            "m_Id": "dcdbf6aef3954f7d84298e6c2685eac9"
        },
        {
            "m_Id": "20bf4d592a7a4bbbb12aa53f5789488a"
        },
        {
            "m_Id": "6f3834764516456cace590c92a170b19"
        },
        {
            "m_Id": "54263747c352461e876a7d002da23709"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "NightVisionPro",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 1. Luminance avec Amplification (Gain)\r\nfloat lum = dot(SceneColor, float3(0.2126, 0.7152, 0.0722));\r\nlum *= Gain;\r\n\r\n// Éblouissement / Overload sur les sources très lumineuses\r\nfloat lightOverload = saturate(lum - 1.2) * 0.6;\r\nlum = saturate(lum);\r\n\r\n// 2. Grain dynamique de scintillation (Phosphore)\r\nfloat2 noiseUV = UV * 1200.0;\r\nfloat noise = frac(sin(dot(noiseUV + float2(Time * 19.0, Time * 47.0), float2(12.9898, 78.233))) * 43758.5453);\r\nlum += (noise - 0.5) * NoiseIntensity;\r\n\r\n// 3. Micro-trame du tube (Scanlines)\r\nfloat scanline = sin(UV.y * 1000.0) * 0.5 + 0.5;\r\nlum -= scanline * ScanlineIntensity * lum;\r\n\r\n// 4. Application de la teinte Phosphore + Surexposition\r\nfloat3 finalColor = (PhosphorColor * lum) + float3(lightOverload, lightOverload, lightOverload);\r\n\r\n// 5. Masque de lentille circulaire (Vignettage NVG)\r\nfloat2 centeredUV = UV - float2(0.5, 0.5);\r\nfloat dist = length(centeredUV);\r\nfloat vignette = 1.0 - smoothstep(VignetteRadius * 0.65, VignetteRadius, dist);\r\n\r\nOut = finalColor * vignette;"
}

