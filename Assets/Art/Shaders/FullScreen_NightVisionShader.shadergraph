    "m_Slots": [
        {
            "m_Id": "a219a43be40147debf6b4644fbcbb722"
        },
        {
            "m_Id": "fc103322a9294bdca6a6810a5c8de203"
        },
        {
            "m_Id": "193e5bf658864dcd872d6050af4937a8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Noise",
    "m_FunctionSource": "7e2c392a48aa8814c8510ad84eae8ccf",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// On crée une valeur basée sur les coordonnées de l'écran\r\nfloat random_val = dot(UV, float2(12.9898, 78.233));\r\n\r\n// On ajoute le temps pour animer le bruit, puis on génère le chaos avec des fonctions mathématiques\r\nOut = frac(sin(random_val + Time) * 43758.5453);"
}

